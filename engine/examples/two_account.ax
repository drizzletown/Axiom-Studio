// AX-HLD-1.0 §4.5. Finite, sequential account model (not C++ proof).
model TwoAccount {
  type Amount = Int[0..3]
  state { a: Amount b: Amount }
  init { a == 3 && b == 0 }
  action move(m: Amount) -> Bool {
    case m > 0 && m <= a && b + m <= 3 {
      modifies { a, b }
      ensures a' == a - m && b' == b + m && result == true
    }
    case otherwise {
      modifies { }
      ensures result == false
    }
  }
  property NonNegative { always a >= 0 && b >= 0 }
  property Conservation { always a + b == 3 }
  observe { move.input, move.output }
}
